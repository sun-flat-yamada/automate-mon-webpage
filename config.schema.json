{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomateMonWebpageConfig",
  "description": "Configuration schema for webpage monitoring targets",
  "type": "object",
  "required": ["targets"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "targets": {
      "type": "array",
      "description": "List of monitoring targets",
      "items": {
        "type": "object",
        "required": ["name", "url", "selector", "extractor_type"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier name for the monitoring target"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Target webpage URL to monitor"
          },
          "selector": {
            "type": "string",
            "description": "CSS selector for the target element to capture/extract (empty string for full page)"
          },
          "extractor_type": {
            "type": "string",
            "enum": ["dell-outlet"],
            "description": "Extractor strategy type"
          }
        }
      }
    }
  }
}
